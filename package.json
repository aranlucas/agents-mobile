{
  "name": "agents-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "postinstall": "node scripts/expo-postinstall.mjs",
    "prepare": "husky",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "portless run expo start --web",
    "eas:env:production": "pnpm dlx eas-cli env:list production --format long",
    "eas:env:pull:production": "pnpm dlx eas-cli env:pull production --path .env.local",
    "build": "pnpm dlx eas-cli build --profile production --platform android --local",
    "build:preview:android": "pnpm dlx eas-cli build --profile preview --platform android",
    "build:production:android": "pnpm dlx eas-cli build --profile production --platform android",
    "build:production:all": "pnpm dlx eas-cli build --profile production --platform all",
    "build:local:preview:android": "pnpm dlx eas-cli env:exec preview \"pnpm dlx eas-cli build --profile preview --platform android --local\"",
    "build:local:production:android": "pnpm dlx eas-cli env:exec production \"pnpm dlx eas-cli build --profile production --platform android --local\"",
    "build:local:production:android:env-file": "sh -c 'if [ -f .env.local ]; then set -a; . ./.env.local; set +a; fi; pnpm dlx eas-cli build --profile production --platform android --local'",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/expo": "^4.14.0",
    "@copilotkit/react-native": "1.79.1",
    "@expo/metro-runtime": "~58.0.15",
    "@sentry/react-native": "~8.31.0",
    "expo": "^58.0.17",
    "expo-asset": "~58.0.18",
    "expo-auth-session": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "remend": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@babel/core": "^7.29.7",
    "@react-native/metro-config": "0.88.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "bufferutil": "4.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdown-it": "^15.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "react-test-renderer": "19.3.1",
    "supports-color": "11.0.0",
    "typescript": "~6.0.3",
    "utf-8-validate": "6.0.6",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
